{
    "device": "cuda",
    "add_random_test_samples": 0,
    "save_output": true,
    
    "test_sample_verbose": false,
    "test_samples_seed": 0,
    "test_samples": [
        "switch/Arcaea/_t_songs_ignotus.ogg.flac",
        "switch/Splatoon 3/BGM_Mission_Stage_Crater_01.bwav.flac"
    ],

    "format_config": {

        "last_global_step": 0,
        
        "sample_rate": 32000,
        "num_raw_channels": 2,
        //"default_raw_length": 3833600,
        //"default_raw_length": 2817536,
        //"default_raw_length": 2097152,
        //"default_raw_length": 1408768,
        "default_raw_length": 196608,
        //"default_raw_length": 131072,
        //"default_raw_length": 96000,
        "width_alignment": 8192,

        "mdct_psd_exponent": 0.25,
        "window_len": 127,
        "window_func": "hann",

        // standard p config, from paper
        "ms_psd_p_real": [ [ 2,0], [1,1], [-1,1], [0,1] ],
        "ms_psd_p_imag": [ [ 0,0], [0,0], [ 0,0], [1,0] ],
        "ms_psd_center_p_real": [ 2, 0],
        "ms_psd_center_p_imag": [ 0, 0],

        // to get the minimum required coverage for phase retrieval it would seem that the max value
        // for t_scale is e if ms_psd window is 2x larger than mdct window, e/2 if they are the same size, etc
        // however, if the noise floor is satisfied the longer the window the better
        "ms_psd_t_scale": 2.26,      // -120db noise floor at ms_psd window edge
        //"ms_psd_t_scale": 2.71828, 
        //"ms_psd_t_scale": 5.436563657,
        //"ms_psd_t_scale": 3.14,

        "ms_psd_window_len": 255,
        "ms_psd_num_filters": 64,
        "ms_psd_filter_alpha": 1,

        "mel_spec_config": {
            "sample_rate": 32000,
            "ms_add_center_channel": true,
            "ms_img_show_center_channel": true,
            "ms_abs_exponent": 0.25,
            "ms_freq_min": 0,
            "ms_num_filters": 256,
            "ms_hop_length": 256,
            "ms_window_length": 4096,
            "ms_window_exponent": 15
        }
    }
}